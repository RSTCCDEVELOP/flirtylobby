# System links (mail, payment, AI): made and switched on at start and at the first login. Never commit real keys.
EASY2EDIT_POSTMARK_TOKEN=
EASY2EDIT_POSTMARK_FROM=
EASY2EDIT_STRIPE_KEY=
EASY2EDIT_ANTHROPIC_KEY=
