# Copy to /opt/easy2edit/.env on the VPS
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com
IMAGE_PREFIX=ghcr.io/<github-owner-lowercase>/easy2edit

DJANGO_SECRET_KEY=change-me
