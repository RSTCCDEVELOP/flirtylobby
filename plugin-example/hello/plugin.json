    {
      "key": "greeting",
      "label": "Begroeting",
      "type": "text",
      "default": "Hallo",
      "hint": "Deze tekst staat op de pagina van de plugin."
    },
    {
      "key": "loud",
      "label": "Roepen (hoofdletters)",
      "type": "bool",
      "default": false
    },
    {
      "key": "notify_email",
      "label": "Mail bij nieuwe leden naar",
      "type": "text",
      "default": ""
    },
    {
      "key": "api_key",
      "label": "Geheime sleutel (voorbeeld)",
      "type": "secret",
      "default": ""
    }
  ]
}
