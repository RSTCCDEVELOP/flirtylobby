{
  "name": "hello",
  "title": "Hello (voorbeeldplugin)",
  "version": "1.0.0",
  "system_version": "1.0.0",
  "schema": 0,
  "description": "Voorbeeld om mee te beginnen: een eigen pagina in het dashboard, een route, een gebeurtenis en instellingen.",
  "author": "RST Coaching & Consultancy",
  "section": "system",
  "python": "plugin.py",
  "web": "web/index.html",
  "menu": {
    "label": "Hello",
    "access": "members"
  },
  "permissions": [
    "gebruikers lezen",
    "e-mail versturen"
  ],
  "events": [
    "user_registered",
    "listing_created"
  ],
